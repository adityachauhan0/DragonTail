{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "window-state:default",
    "allow-pref-get",
    "allow-pref-set",
    "allow-tailnet-snapshot",
    "allow-tailnet-ping",
    "allow-tailnet-netcheck",
    "allow-tailscale-version",
    "allow-pty-open",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-kill",
    "allow-titlebar-set-holes",
    "allow-vnc-probe",
    "allow-vnc-argv",
    "allow-vnc-bridge-open",
    "allow-vnc-bridge-close",
    "allow-vnc-tunnel-open",
    "allow-vnc-tunnel-close",
    "allow-taildrop-send",
    "allow-taildrop-cancel",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-delete",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-current-monitor",
    "core:webview:allow-create-webview-window",
    "core:event:allow-emit",
    "core:event:allow-listen"
  ]
}
